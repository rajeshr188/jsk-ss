# Compose/release identity. Deploy only the approved CI-published registry digest.
APP_IMAGE=ghcr.io/rajeshr188/jsk-savings@sha256:replace-with-approved-manifest-digest
APP_RELEASE=replace-with-commit-sha
# PWA and Android association are independently reversible. Enable only after the
# published image and canonical-domain endpoints pass their rollout checks.
PWA_ENABLED=False
ANDROID_TWA_ASSET_LINKS_ENABLED=False
APP_ENV_FILE=.env.production
ACME_EMAIL=replace-with-certificate-contact@example.com
LINODE_DB_CA_FILE=/opt/jsk/secrets/linode-db-ca.crt

# Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-64-byte-random-production-secret
DJANGO_SECRET_KEY_FALLBACKS=
ALLOWED_HOSTS=jaishrikrishnajewellery.com,www.jaishrikrishnajewellery.com
CSRF_TRUSTED_ORIGINS=https://jaishrikrishnajewellery.com,https://www.jaishrikrishnajewellery.com
WAGTAILADMIN_BASE_URL=https://jaishrikrishnajewellery.com
# Public-content features remain explicit and fail-closed in a new deployment.
# Enable only after the corresponding Wagtail content and authorization checks pass.
PUBLIC_CATALOGUE_ENABLED=False
PUBLIC_EDITORIAL_PAGES_ENABLED=False
PUBLIC_BLOG_ENABLED=False

# Dedicated Cloudflare R2 Standard bucket. The token must have Object Read & Write
# access to this bucket only. R2_CUSTOM_DOMAIN is a hostname, not a URL.
MEDIA_STORAGE_BACKEND=r2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret-access-key
R2_BUCKET_NAME=jsk-media-production
R2_CUSTOM_DOMAIN=media.jaishrikrishnajewellery.com
R2_SIGNED_URL_EXPIRY_SECONDS=900

# Linode Managed PostgreSQL. URL-encode the user and password. The CA is mounted
# by Compose at /run/secrets/linode_db_ca.pem.
DATABASE_URL=postgresql://jsk_app:replace-with-url-encoded-password@replace-with-managed-db-host:replace-with-managed-db-port/jsk_savings?sslmode=verify-full&sslrootcert=/run/secrets/linode_db_ca.pem
DATABASE_CONN_MAX_AGE=60

# Real SMTP delivery is required in every Razorpay mode.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=replace-with-smtp-host
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="Jai Sri Krishna Jewellery <noreply@jaishrikrishnajewellery.com>"
SERVER_EMAIL=errors@jaishrikrishnajewellery.com
CUSTOMER_INVITATION_EXPIRY_HOURS=72
# Google is an optional credential for an existing approved customer; it never
# creates or approves a customer. Store the client secret only on the server.
CUSTOMER_GOOGLE_LOGIN_ENABLED=False
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
# Staged registration never unlocks django-allauth's direct public signup. Enable
# only after migrations, policy versions, SMTP, owner queue, and integrity checks pass.
PUBLIC_CUSTOMER_REGISTRATION_ENABLED=False
PUBLIC_REGISTRATION_EMAIL_EXPIRY_HOURS=24
PUBLIC_REGISTRATION_ATTEMPTS_PER_HOUR=5
PUBLIC_REGISTRATION_ATTEMPT_RETENTION_HOURS=24
PUBLIC_REGISTRATION_TERMS_VERSION=2026-09-05
PUBLIC_REGISTRATION_PRIVACY_VERSION=2026-09-05
# Keep disabled until ADR-0015's qualified retention matrix, policy wording,
# provider procedures, migration, and synthetic acceptance checks are complete.
CUSTOMER_ACCOUNT_DELETION_ENABLED=False
CUSTOMER_ACCOUNT_DELETION_EMAIL_EXPIRY_HOURS=24
CUSTOMER_ACCOUNT_DELETION_ATTEMPTS_PER_HOUR=5
CUSTOMER_ACCOUNT_DELETION_ATTEMPT_RETENTION_HOURS=24
CUSTOMER_ACCOUNT_DELETION_OWNER_REVIEW_DAYS=7
CUSTOMER_ACCOUNT_DELETION_COMPLETION_TARGET_DAYS=30
CUSTOMER_ACCOUNT_DELETION_POLICY_VERSION=
# Non-binding scheme-interest requests. Enable only after owner/customer email,
# owner queue, conversion, and no-financial-mutation-before-approval checks pass.
CUSTOMER_ENROLMENT_REQUESTS_ENABLED=False
CUSTOMER_ENROLMENT_REQUEST_EXPIRY_DAYS=30
CUSTOMER_ENROLMENT_REQUEST_DISCLOSURE_VERSION=2026-09-04
# Preview recipients with send_scheme_reminders before first enablement and after
# recipient-policy changes; delivery remains independently reversible.
SCHEME_REMINDERS_ENABLED=False
SCHEME_REMINDER_ELIGIBILITY_DAYS=30,7,1
SCHEME_REMINDER_CUSTOMER_ELIGIBILITY=True
SCHEME_REMINDER_OWNER_ELIGIBILITY=True
SCHEME_REMINDER_OWNER_ALLOCATION_EXCEPTIONS=True
SCHEME_REMINDER_CUSTOMER_REDEMPTIONS=True
SCHEME_REMINDER_OWNER_REDEMPTIONS=True
SCHEME_REMINDER_RETRY_LIMIT=3
SCHEME_REMINDER_BASE_URL=https://jaishrikrishnajewellery.com

# Start a new deployment in test mode. Promote to live only through the production
# activation gates, changing mode and all three credentials atomically; the webhook
# signing secret is separate from the API key secret.
PAYMENT_GATEWAY=razorpay
PAYMENT_INITIATION_KILL_SWITCH=False
# Enable only after the cash-receipt/reversal preflight and controlled smoke pass.
IN_STORE_CASH_CONTRIBUTIONS_ENABLED=False
IN_STORE_CASH_REVERSAL_HOURS=24
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-fresh-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-separate-test-webhook-secret
RAZORPAY_TIMEOUT_SECONDS=10
# Application Checkout lifetime; accepted production range is 3-15 minutes.
RAZORPAY_CHECKOUT_EXPIRY_MINUTES=10

# Caddy is the only public path to Django and overwrites X-Forwarded-Proto.
SECURE_SSL_REDIRECT=True
TRUST_PROXY_SSL_HEADER=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=INFO
