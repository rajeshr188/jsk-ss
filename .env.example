DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_DEBUG=True
APP_RELEASE=local
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://jsk_user:replace-me@localhost:5432/jsk_savings
DATABASE_CONN_MAX_AGE=0
PAYMENT_GATEWAY=mock
# Emergency fail-safe for new payment/order creation. It does not disable webhooks.
PAYMENT_INITIATION_KILL_SWITCH=False
# Owner-only recording of cash received at the showroom for metal schemes.
IN_STORE_CASH_CONTRIBUTIONS_ENABLED=False
IN_STORE_CASH_REVERSAL_HOURS=24
# For Razorpay, set PAYMENT_GATEWAY=razorpay, choose test or live, and configure all values.
RAZORPAY_MODE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT_SECONDS=10
RAZORPAY_CHECKOUT_EXPIRY_MINUTES=10
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WAGTAILADMIN_BASE_URL=http://localhost:8000
# Enable only after the catalogue root is published and public checks pass.
PUBLIC_CATALOGUE_ENABLED=False
# Enable only after the seeded About page is reviewed and published in Wagtail.
PUBLIC_EDITORIAL_PAGES_ENABLED=False
# Keep filesystem locally. Use r2 only with an isolated non-production bucket.
MEDIA_STORAGE_BACKEND=filesystem
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_CUSTOM_DOMAIN=
R2_SIGNED_URL_EXPIRY_SECONDS=900
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com
CUSTOMER_INVITATION_EXPIRY_HOURS=72
LOG_LEVEL=INFO
TRUST_PROXY_SSL_HEADER=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
