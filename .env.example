DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_DEBUG=True
APP_RELEASE=local
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://jsk_user:replace-me@localhost:5432/jsk_savings
DATABASE_CONN_MAX_AGE=0
PAYMENT_GATEWAY=mock
# For Razorpay test mode, set PAYMENT_GATEWAY=razorpay and configure all values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT_SECONDS=10
METAL_RATE_PROVIDER=mock
# For live rates, set METAL_RATE_PROVIDER=goldapi and add a real key below.
GOLDAPI_API_KEY=
GOLDAPI_TIMEOUT_SECONDS=10
GOLDAPI_CACHE_SECONDS=60
MOCK_GOLD_RATE=12500.0000
MOCK_SILVER_RATE=150.0000
MOCK_GOLD_PURITY=0.9999
MOCK_SILVER_PURITY=0.9990
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com
LOG_LEVEL=INFO
TRUST_PROXY_SSL_HEADER=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
