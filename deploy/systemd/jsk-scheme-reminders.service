[Unit]
Description=Jai Sri Krishna Jewellery scheme reminder delivery
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/jsk/app
ExecStart=/usr/bin/docker compose --env-file .env.production -f compose.production.yml exec -T web python manage.py send_scheme_reminders --apply
TimeoutStartSec=5min

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
