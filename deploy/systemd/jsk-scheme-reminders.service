[Unit]
Description=Jai Sri Krishna Jewellery scheme reminder delivery
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/jsk/app
RuntimeDirectory=jsk-scheme-reminders
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=/run/jsk-scheme-reminders
ExecStart=/usr/bin/docker exec jsk-savings-web-1 python manage.py send_scheme_reminders --apply
TimeoutStartSec=5min

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
